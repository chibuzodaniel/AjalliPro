generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  SALES_STAFF
  // EDITOR // disabled for now — not an assignable role, no users currently hold it
  ADMIN_STAFF
  ADMIN
  SUPER_ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(SALES_STAFF)
  dailyRecordApprover Boolean @default(false) // Admin explicitly assigned by Super Admin to be notified about daily records awaiting approval (Super Admin is always notified regardless)
  createdAt    DateTime @default(now())

  dailyRecordsCreated  DailyRecord[]      @relation("DailyRecordCreatedBy")
  dailyRecordsApproved DailyRecord[]      @relation("DailyRecordApprovedBy")
  driversCreated       Driver[]           @relation("DriverCreatedBy")
  driversApproved      Driver[]           @relation("DriverApprovedBy")
  customersCreated     Customer[]
  activityLogs         ActivityLog[]
  expensesMarkedPaid   ExpenseItem[]      @relation("ExpensePaidBy")
  pushSubscriptions    PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model DailyRecord {
  id                 String         @id @default(cuid())
  date               String         @unique // 'YYYY-MM-DD'
  openingStock       Int
  closingStock       Int
  factoryBags        Int            @default(0)
  factoryPricePerBag Int            @default(0)
  factoryCustomerId  String?
  factoryCustomer    Customer?      @relation("FactoryCustomer", fields: [factoryCustomerId], references: [id])
  factoryBagsFromLeakage Int        @default(0) // subset of factoryBags rebagged from the leakage pile, not fresh production
  pumpWaterAmount    Int            @default(0)
  leakageOpening     Int            @default(0) // leakage pile balance carried from the previous approved record
  leakageBags        Int            @default(0) // NEW leakage logged today, added to the pile
  leakageWasteBags   Int            @default(0) // bags lost/spoiled while rebagging leakage stock — not sellable, not carried forward
  leakageClosing     Int            @default(0) // leakageOpening + leakageBags - factoryBagsFromLeakage - leakageWasteBags
  status             ApprovalStatus @default(PENDING)
  createdById        String
  createdBy          User           @relation("DailyRecordCreatedBy", fields: [createdById], references: [id])
  createdByRole      Role
  approvedById       String?
  approvedBy         User?          @relation("DailyRecordApprovedBy", fields: [approvedById], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  productionLines ProductionLine[]
  driverSales     DriverSale[]
  truckDeliveries TruckDelivery[]
  expenseItems    ExpenseItem[]

  @@index([status])
  @@index([date])
}

model ExpenseItem {
  id            String      @id @default(cuid())
  dailyRecordId String
  dailyRecord   DailyRecord @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)
  description   String
  amount        Int
  paid          Boolean     @default(false)
  paidAt        DateTime?
  paidById      String?
  paidBy        User?       @relation("ExpensePaidBy", fields: [paidById], references: [id])

  @@index([dailyRecordId])
  @@index([paid])
}

model ProductionLine {
  id            String      @id @default(cuid())
  dailyRecordId String
  dailyRecord   DailyRecord @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)
  packerName    String
  bags          Int

  @@index([dailyRecordId])
}

model Driver {
  id           String         @id @default(cuid())
  name         String
  phone        String?
  pricePerBag  Int            @default(0) // fixed by Admin/Super Admin, applied automatically on each sale
  loadingFee   Int            @default(0) // per-bag rate fixed by Admin/Super Admin, multiplied by bags on each sale
  status       ApprovalStatus @default(PENDING)
  createdById  String
  createdBy    User           @relation("DriverCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?          @relation("DriverApprovedBy", fields: [approvedById], references: [id])
  createdAt    DateTime       @default(now())

  sales DriverSale[]
}

model DriverSale {
  id            String      @id @default(cuid())
  dailyRecordId String
  dailyRecord   DailyRecord @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)
  driverId      String
  driver        Driver      @relation(fields: [driverId], references: [id])
  customerId    String?
  customer      Customer?   @relation("DriverSaleCustomer", fields: [customerId], references: [id])
  bags          Int
  pricePerBag   Int // snapshot of the driver's fixed price/bag at the time of this sale
  loadingFee    Int         @default(0) // snapshot of the driver's fixed loading fee/bag at the time of this sale
  loadingFeeWaived Boolean  @default(false) // marked not applicable for this sale — no loading fee expense is generated
  bonusBags     Int         @default(0) // instant incentive bags, entered manually by the recorder

  @@index([dailyRecordId])
  @@index([driverId])
  @@index([customerId])
}

model TruckDelivery {
  id            String      @id @default(cuid())
  dailyRecordId String
  dailyRecord   DailyRecord @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  bags          Int
  bonusBags     Int         @default(0) // instant incentive bags given free to this customer, entered manually by the recorder
  pricePerBag   Int         @default(0) // snapshot of the customer's set price at the time of this delivery
  ownTruck      Boolean     @default(true)
  fuelCost      Int         @default(0) // used when ownTruck = true
  hiredCost     Int         @default(0) // used when ownTruck = false (price paid to the hired truck)

  @@index([dailyRecordId])
  @@index([customerId])
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  address     String?
  pricePerBag Int      @default(0) // fixed by Admin/Super Admin, used for truck delivery revenue when this customer is selected
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  factorySalesAsCustomer DailyRecord[]   @relation("FactoryCustomer")
  driverSalesAsCustomer  DriverSale[]    @relation("DriverSaleCustomer")
  truckDeliveries        TruckDelivery[]
  mailLogs               MailLog[]
}

model MailLog {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  weekKey    String
  sentAt     DateTime @default(now())

  @@index([customerId])
  @@index([weekKey])
}

model IncentiveTier {
  id    String @id @default(cuid())
  min   Int
  max   Int
  bonus Int
}

model PricingSetting {
  id                 String   @id @default("singleton")
  factoryPricePerBag Int      @default(0)
  updatedAt          DateTime @updatedAt
}

model WeeklyIncentiveSetting {
  id                      String   @id @default("singleton")
  customerWeeklyThreshold Int      @default(500)
  customerWeeklyBonus     Int      @default(5)
  driverWeeklyThreshold   Int      @default(1000)
  driverWeeklyBonus       Int      @default(10)
  updatedAt               DateTime @updatedAt
}

model EmailTemplateSetting {
  id            String   @id @default("singleton")
  subject       String   @default("Your Ajalli Table Water summary — week {{week}}")
  introText     String   @default("Here's your purchase summary for this week:")
  signatureText String   @default("Thank you for your business.\nCusica International — Ajalli Table Water")
  updatedAt     DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  text      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
